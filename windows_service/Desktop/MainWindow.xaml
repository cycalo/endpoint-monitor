<Window x:Class="EndpointMonitorService.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Endpoint Monitor"
        Width="1180" Height="780"
        MinWidth="1040" MinHeight="680"
        Background="{StaticResource CsSurfaceBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource CsSurfaceContainerLowestBrush}"
                BorderBrush="{StaticResource CsGhostBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="16,22,12,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="8"
                                Background="#2206B6D4"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE730;"
                                       FontFamily="{StaticResource CsFontIcon}"
                                       FontSize="16"
                                       Foreground="{StaticResource CsPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Endpoint Monitor"
                                       FontFamily="{StaticResource CsFontUi}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource CsOnSurfaceBrush}" />
                            <TextBlock Text="PC setup console"
                                       FontFamily="{StaticResource CsFontUi}"
                                       FontSize="11"
                                       Foreground="{StaticResource CsOnSurfaceVariantBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{StaticResource CsGhostBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,14,16,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse x:Name="ServiceDot"
                                     Width="8" Height="8"
                                     VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#64748B" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="ServiceLabel"
                                       Text="Checking service"
                                       Margin="8,0,0,0"
                                       FontFamily="{StaticResource CsFontUi}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource CsOnSurfaceVariantBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="VersionText"
                                   Text="Agent -"
                                   FontFamily="{StaticResource CsFontMono}"
                                   FontSize="11"
                                   Foreground="{StaticResource CsOnSurfaceVariantBrush}" />
                        <TextBlock x:Name="UptimeText"
                                   Text="Up -"
                                   Margin="0,4,0,0"
                                   FontFamily="{StaticResource CsFontMono}"
                                   FontSize="11"
                                   Foreground="{StaticResource CsOnSurfaceVariantBrush}" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="NavPanel" Margin="0,8,0,0">
                    <RadioButton x:Name="NavHome" Style="{StaticResource CsNavButton}" IsChecked="True" GroupName="Nav">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource CsNavGlyph}" />
                            <TextBlock Text="Home" Style="{StaticResource CsNavLabel}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPair" Style="{StaticResource CsNavButton}" GroupName="Nav">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71B;" Style="{StaticResource CsNavGlyph}" />
                            <TextBlock Text="Pair" Style="{StaticResource CsNavLabel}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavDevices" Style="{StaticResource CsNavButton}" GroupName="Nav">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE717;" Style="{StaticResource CsNavGlyph}" />
                            <TextBlock Text="Devices" Style="{StaticResource CsNavLabel}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavDiagnostics" Style="{StaticResource CsNavButton}" GroupName="Nav">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE730;" Style="{StaticResource CsNavGlyph}" />
                            <TextBlock Text="Diagnostics" Style="{StaticResource CsNavLabel}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource CsNavButton}" GroupName="Nav">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource CsNavGlyph}" />
                            <TextBlock Text="Settings" Style="{StaticResource CsNavLabel}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="PageScroll"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="28,22,28,28"
                      SizeChanged="PageScroll_SizeChanged">
            <Grid>
                <ContentControl x:Name="PageHost"
                                MaxWidth="1080"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
