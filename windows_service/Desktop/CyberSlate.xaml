<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Layered elevation: window, cards, borders, cyan actions, cobalt secondary. -->
    <Color x:Key="CsSurface">#0B0F17</Color>
    <Color x:Key="CsSurfaceContainer">#151C28</Color>
    <Color x:Key="CsSurfaceContainerLow">#1B2433</Color>
    <Color x:Key="CsSurfaceContainerLowest">#0E141F</Color>
    <Color x:Key="CsOnSurface">#E8EEF9</Color>
    <Color x:Key="CsOnSurfaceVariant">#93A0B8</Color>
    <Color x:Key="CsPrimary">#06B6D4</Color>
    <Color x:Key="CsOnPrimary">#042028</Color>
    <Color x:Key="CsTertiary">#3B82F6</Color>
    <Color x:Key="CsError">#F87171</Color>
    <Color x:Key="CsOutlineVariant">#232E42</Color>
    <Color x:Key="CsSuccess">#34D399</Color>

    <SolidColorBrush x:Key="CsSurfaceBrush" Color="{StaticResource CsSurface}" />
    <SolidColorBrush x:Key="CsSurfaceContainerBrush" Color="{StaticResource CsSurfaceContainer}" />
    <SolidColorBrush x:Key="CsSurfaceContainerLowBrush" Color="{StaticResource CsSurfaceContainerLow}" />
    <SolidColorBrush x:Key="CsSurfaceContainerLowestBrush" Color="{StaticResource CsSurfaceContainerLowest}" />
    <SolidColorBrush x:Key="CsOnSurfaceBrush" Color="{StaticResource CsOnSurface}" />
    <SolidColorBrush x:Key="CsOnSurfaceVariantBrush" Color="{StaticResource CsOnSurfaceVariant}" />
    <SolidColorBrush x:Key="CsPrimaryBrush" Color="{StaticResource CsPrimary}" />
    <SolidColorBrush x:Key="CsOnPrimaryBrush" Color="{StaticResource CsOnPrimary}" />
    <SolidColorBrush x:Key="CsTertiaryBrush" Color="{StaticResource CsTertiary}" />
    <SolidColorBrush x:Key="CsErrorBrush" Color="{StaticResource CsError}" />
    <SolidColorBrush x:Key="CsSuccessBrush" Color="{StaticResource CsSuccess}" />
    <SolidColorBrush x:Key="CsGhostBorderBrush" Color="{StaticResource CsOutlineVariant}" />

    <FontFamily x:Key="CsFontUi">Segoe UI</FontFamily>
    <FontFamily x:Key="CsFontMono">Cascadia Mono, Cascadia Code, Consolas</FontFamily>
    <FontFamily x:Key="CsFontIcon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="CsCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CsSurfaceContainerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CsGhostBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="CsPageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CsFontUi}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CsOnSurfaceBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="CsKicker" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CsFontUi}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CsOnSurfaceVariantBrush}" />
    </Style>

    <Style x:Key="CsBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CsFontUi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource CsOnSurfaceVariantBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <Style x:Key="CsLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CsFontUi}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CsOnSurfaceVariantBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="CsValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CsFontUi}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource CsOnSurfaceBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CsMono" TargetType="TextBlock" BasedOn="{StaticResource CsValue}">
        <Setter Property="FontFamily" Value="{StaticResource CsFontMono}" />
    </Style>

    <Style x:Key="CsPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CsPrimaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource CsOnPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource CsFontUi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CsSecondaryButton" TargetType="Button" BasedOn="{StaticResource CsPrimaryButton}">
        <Setter Property="Background" Value="{StaticResource CsSurfaceContainerLowBrush}" />
        <Setter Property="Foreground" Value="{StaticResource CsOnSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CsGhostBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CsNavGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CsFontIcon}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
    </Style>

    <Style x:Key="CsNavLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
    </Style>

    <Style x:Key="CsNavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource CsOnSurfaceVariantBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource CsFontUi}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,1,0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Accent"
                                Width="3"
                                HorizontalAlignment="Left"
                                Margin="0,8"
                                CornerRadius="1.5"
                                Background="Transparent" />
                        <Border x:Name="Bd"
                                Margin="8,0,8,0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CsPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1F06B6D4" />
                            <Setter TargetName="Accent" Property="Background" Value="{StaticResource CsPrimaryBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource CsPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CsStatusPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="CsChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CsSurfaceContainerLowBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CsGhostBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>

</ResourceDictionary>
