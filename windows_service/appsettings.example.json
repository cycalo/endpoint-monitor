{
  "Auth": {
    "Token": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET",
    "JwtSigningKey": "CHANGE_THIS_TO_A_LONG_RANDOM_JWT_SIGNING_KEY_AT_LEAST_32_CHARS",
    "JwtExpiryDays": 30
  },
  "Server": {
    "Port": 5000,
    "UseHttps": false,
    "HttpsPort": 5001
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*:/api/auth/token",
        "Period": "1m",
        "Limit": 20
      }
    ]
  },
  "IpRateLimitPolicies": {},
  "AllowedHosts": "*",
  "AllowedIpAddresses": []
}
