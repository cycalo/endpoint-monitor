{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter App (Debug)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/flutter_app"
    },
    {
      "name": "Windows Service (.NET Launch)",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "run"
      ],
      "cwd": "${workspaceFolder}/windows_service",
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Windows Service (.NET Attach)",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
